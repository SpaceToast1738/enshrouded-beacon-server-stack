# enshrouded-beacon-server-stack — operator configuration
#
# Copy this file to `.env` (or set the vars in your shell /
# Docker secrets) before running `docker compose up -d`. Every
# var the compose file consumes lives here.
#
# `.env` is in .gitignore — never commit a filled-in copy.

# ── Dashboard (REQUIRED) ────────────────────────────────────
# Where the beacon container posts (every 30s to <DASHBOARD_URL>/ingest).
# Two modes:
#   SPLIT (default) — your dashboard runs on a SEPARATE host. Put its
#     public HTTPS URL here; TLS is handled by that host's Cloudflare
#     tunnel / reverse-proxy.
#       DASHBOARD_URL=https://your-dashboard.example.com
#   CO-LOCATED — you run the dashboard ON THIS host too (the opt-in
#     `dashboard` profile, see the "Co-located all-in-one" section
#     below). The beacon then posts over the compose network to the
#     local dashboard service — plain HTTP on localhost, never leaves
#     the box:
#       DASHBOARD_URL=http://dashboard:8000
DASHBOARD_URL=https://your-dashboard.example.com

# Plaintext ingest token. Issued from the dashboard's
#   /admin  →  Dedicated servers  →  Register a new dedicated server
# Shown ONCE at issue time; paste here. Treat like a password.
# Lost it? Reissue from /admin — no recovery path.
ESB_TOKEN=

# ── Enshrouded dedicated server (REQUIRED) ──────────────────
# Friendly name displayed to players + on the dashboard's
# `→ hosted on <server>` chip.
SERVER_NAME=My Fellowship Server

# Optional password gate. Empty string = public server.
SERVER_PASSWORD=

# Max players. 1-16 supported by the game.
SERVER_SLOTS=16

# ── Game ports (UDP) ────────────────────────────────────────
# All three must be open on the host's firewall (see
# docs/port-forwarding.md for ufw recipe).
GAME_PORT=15636
QUERY_PORT=15637
# 15638 is hardcoded in docker-compose.yml; some Enshrouded
# server versions also need it.

# ── Optional ────────────────────────────────────────────────
# Local timezone (used by watchtower for log timestamps).
# Defaults to UTC if unset.
# TZ=America/New_York

# Tag-pinning: by default we use `:latest` + Watchtower for
# auto-updates. To pin specific image versions, comment out the
# `watchtower` service in docker-compose.yml and edit the
# `image:` lines to use specific tags instead of `:latest`.

# ── Diagnostic bundles (0.44.0+) ────────────────────────────
# Default: OFF. When set to `1`, lets the dashboard maintainer
# request raw save / config / log bundles from this beacon for
# offline reverse-engineering + catalog mining work.
#
# Triggered by the dashboard admin clicking "Request bundle" on
# `/admin → Dedicated servers → <your server>`. The beacon
# picks up the request on its next /ingest poll cycle (~30 s),
# builds a gzipped tarball (≤ 10 MB), and POSTs it to the
# dashboard. The tarball contains:
#   - the active save slot (binary KSC1 container)
#   - enshrouded_server.json (with passwords/tokens redacted)
#   - last 1 MB of enshrouded_server.log
#   - optionally, selected `.dat` files from the game install
#     dir (when "Include install .dat" was checked)
#
# WHY OFF BY DEFAULT: save files contain player names + base
# positions + quest progress. The structured wire payload that
# normally flows on /ingest is aggregated + redacted by design;
# bundles ship raw bytes. Only enable if you trust the dashboard
# maintainer with your full save state.
#
# Operators who DON'T want to enable this: just leave the line
# commented or set to `0`. If the dashboard admin requests a
# bundle, the beacon responds with `status=refused` and the
# admin sees "operator opt-out" instead of stuck-pending.
#
# To enable:
# ESB_ALLOW_DIAGNOSTIC_BUNDLES=1

# ── Edit settings from the website (0.90.0+) ────────────────
# Default: OFF (read-only). When enabled, admins on your
# dashboard can edit this server's gameSettings (difficulty
# multipliers, enemy/XP factors, day-night cycle, etc.) AND
# restart the server to apply them — without SSHing in.
#
# Requires dashboard + beacon image 0.90.0+.
#
# ⚠ This is opt-in at FOUR layers — all are required for it to
# actually work end-to-end. Read docs/server-settings.md before
# enabling; the EXTERNAL_CONFIG + chown steps are easy to miss
# and the feature fails SILENTLY without them.
#
#   1. EXTERNAL_CONFIG=1 (below) — stops the dedicated-server
#      image regenerating enshrouded_server.json on every boot.
#      WITHOUT THIS, your edits are wiped the next time the
#      server restarts.
#   2. Flip the config bind-mount from `:ro` to `:rw` in
#      docker-compose.yml (beacon service).
#   3. Make the config file writable by the beacon (uid 10100):
#        sudo chown 10100 data/enshrouded/enshrouded_server.json
#   4. ESB_ALLOW_SETTINGS_WRITE=1 (below).
#
# For RESTART-from-website too: also uncomment the `docker-proxy`
# service in docker-compose.yml and set ESB_ALLOW_SERVER_RESTART=1.
# Without it, edits land but you restart the server yourself.
#
# Security: the save dir stays read-only; only the single config
# FILE becomes writable, and only when you set all of the above.
# Leave everything off and the beacon behaves exactly as before.
#
# EXTERNAL_CONFIG=1
# ESB_ALLOW_SETTINGS_WRITE=1
# ESB_ALLOW_SERVER_RESTART=1
# ESB_SERVER_CONTAINER_NAME=enshrouded-server

# ── Co-located all-in-one dashboard (OPT-IN) ────────────────
# Run the DASHBOARD on this same host (the `dashboard` + `cloudflared`
# services, started with `docker compose --profile dashboard up -d`)
# instead of forwarding to a separate box. Use this when the dashboard
# was hosted somewhere with a poor uplink (e.g. a home server) and you
# want distant players to reach a datacenter VPS directly.
#
# Full walkthrough — incl. migrating your existing SQLite DB onto this
# host with zero data loss — is in docs/co-located-dashboard.md.
#
# When you enable the profile, ALSO set DASHBOARD_URL=http://dashboard:8000
# above so the beacon posts to the local dashboard, and fill in:
#
# Public hostname friends use (KEEP IT THE SAME as your old host so the
# move is invisible to them). Magic-link sign-in emails embed this.
# DASHBOARD_PUBLIC_URL=https://your-dashboard.example.com
#
# Cloudflare tunnel token. Create a tunnel in Cloudflare Zero Trust →
# Networks → Tunnels, add a Public Hostname routing your domain →
# http://dashboard:8000, copy the token here. The tunnel is OUTBOUND
# (cloudflared dials out) so no inbound VPS port is exposed.
# CLOUDFLARED_TOKEN=
#
# Magic-link auth email (Resend). Needed for sign-in to work. Reuse
# the same values your old dashboard host used.
# RESEND_API_KEY=
# RESEND_FROM=Enshrouded Beacon <noreply@your-domain>
#
# Optional GitHub token for the dashboard's /releases proxy (player-
# Beacon auto-update). Empty = that endpoint 503s; harmless otherwise.
# GITHUB_TOKEN=
#
# Shared HMAC secret for the 0.106.0 DIRECT vitals overlay path. MUST
# equal the companion's ESB_VITALS_TICKET_SECRET. Generate once with
# `openssl rand -hex 32`. Empty = direct path off (overlays use hub-SSE).
# VITALS_TICKET_SECRET=
